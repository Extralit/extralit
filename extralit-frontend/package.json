{
  "name": "extralit",
  "version": "0.7.2",
  "private": true,
  "scripts": {
    "dev": "nuxi dev",
    "postinstall": "nuxi prepare",
    "api:types": "openapi-typescript ../openapi/v1.json -o types/generated/api.d.ts",
    "build": "nuxi build",
    "start": "nuxi preview",
    "generate": "nuxi generate",
    "lint": "oxlint --quiet && eslint . --quiet",
    "lint:oxc": "oxlint --quiet",
    "lint:eslint": "eslint . --quiet",
    "lint:fix": "oxlint --quiet --fix && eslint . --quiet --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "precommit": "npm run lint:fix",
    "e2e": "npx playwright test --ui",
    "e2e:report": "npx playwright show-report",
    "e2e:silent": "npx playwright test",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:extraction:seed": "uv run --project ../extralit-server python e2e/extraction/seed/seed_v2_e2e.py",
    "e2e:extraction": "playwright test --project=extraction"
  },
  "dependencies": {
    "@codescouts/events": "^1.0.2",
    "@nuxtjs/i18n": "^10.6.0",
    "@orcid/bibtex-parse-js": "^0.0.25",
    "@perspective-dev/client": "5.6.0",
    "@perspective-dev/server": "5.6.0",
    "@perspective-dev/viewer": "5.6.0",
    "@perspective-dev/viewer-datagrid": "5.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@sereneinserenade/tiptap-search-and-replace": "^0.1.1",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-document": "^3.32.0",
    "@tiptap/extension-hard-break": "^3.32.0",
    "@tiptap/extension-paragraph": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-text": "^3.32.0",
    "@tiptap/extensions": "^3.32.0",
    "@tiptap/pm": "^3.32.0",
    "@tiptap/vue-3": "^3.32.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "dompurify": "^3.4.17",
    "fit-curve": "^0.2.0",
    "highlight.js": "^11.12.0",
    "interactjs": "^1.10.28",
    "js-base64": "^3.9.4",
    "luxon": "^3.4.4",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4",
    "marked-katex-extension": "^5.1.13",
    "mitt": "^3.0.1",
    "nuxt": "^4.6.2",
    "papaparse": "^5.7.0",
    "pinia": "^4.0.3",
    "sass": "~1.105.2",
    "sha.js": "^2.4.12",
    "stringz": "^2.1.0",
    "tabulator-tables": "^6.6.1",
    "ts-injecty": "^1.0.0",
    "vue": "^3.5.43",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@codescouts/test": "^1.0.7",
    "@eslint/js": "^10.0.1",
    "@intlify/eslint-plugin-vue-i18n": "^4.5.1",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "^1.64.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.3.0",
    "@types/tabulator-tables": "^6.3.6",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.62.0",
    "@typescript-eslint/typescript-estree": "^8.62.0",
    "@vercel/config": "^0.12.0",
    "@vitest/coverage-v8": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.88.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "happy-dom": "^20.14.6",
    "openapi-typescript": "^7.13.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.79.0",
    "rimraf": "^6.1.3",
    "typescript": "^5.4.5",
    "vite-svg-loader": "^5.1.3",
    "vitest": "^5.0.3",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.13"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "@intlify/shared": "11.4.13",
    "@intlify/core-base": "11.4.13",
    "@intlify/message-compiler": "11.4.13",
    "@intlify/core": "11.4.13",
    "@sereneinserenade/tiptap-search-and-replace": {
      "@tiptap/core": "$@tiptap/core",
      "@tiptap/pm": "$@tiptap/pm"
    }
  }
}
