{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "trailingComma": "es5",
  "printWidth": 120,
  "tabWidth": 2,
  "semi": true,
  "singleQuote": false,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    ".output",
    ".nuxt",
    ".nuxt-stale-root",
    ".vercel",
    "package-lock.json",
    "types/generated",
    "demo"
  ]
}
